/*
 delay model :       max
 check model :       max
 power model :       max
 capacitance model : max
 other model :       max
*/
library(gpdk045bc) {

  delay_model : table_lookup;
  in_place_swap_mode : match_footprint;

  /* unit attributes */
  time_unit : "1ns";
  voltage_unit : "1V";
  current_unit : "1mA";
  pulling_resistance_unit : "1kohm";
  leakage_power_unit : "1nW";
  capacitive_load_unit (1,pf);

  power_supply () {
      default_power_rail : RAIL_VDD;
      power_rail( RAIL_VDD, 1.08 );
      power_rail( RAIL_VSS, 0 );
  }

  slew_upper_threshold_pct_rise : 90;
  slew_lower_threshold_pct_rise : 10;
  slew_upper_threshold_pct_fall : 90;
  slew_lower_threshold_pct_fall : 10;
  input_threshold_pct_rise : 50;
  input_threshold_pct_fall : 50;
  output_threshold_pct_rise : 50;
  output_threshold_pct_fall : 50;
  nom_process : 1;
  nom_voltage : 1.08;
  nom_temperature : 125;
  operating_conditions ( slow ) {
     process : 1;
     voltage : 1.08;
     temperature : 125;
     power_rail( RAIL_VDD, 1.08 );
     power_rail( RAIL_VSS, 0 );
  }
  default_operating_conditions : slow;
  default_max_transition :      0.8136
  default_fanout_load : 1 ;

  lu_table_template(delay_template_7x1) {
    variable_1 : input_net_transition;
    index_1 ("1000.0, 1001.0, 1002.0, 1003.0, 1004.0, 1005.0, 1006.0");
  }
  lu_table_template(delay_template_7x7) {
    variable_1 : input_net_transition;
